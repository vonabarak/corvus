set timeout=300
set default=0
insmod part_gpt
insmod ext2
insmod search_fs_uuid
serial --unit=0 --speed=115200
terminal_input console serial
terminal_output console serial
menuentry 'Gentoo rescue' {
    if search --no-floppy --fs-uuid --set=root @CARRIER_UUID@; then
        linux /vmlinuz root=rescue:UUID=@CARRIER_UUID@ ro fsck.mode=skip rd.fstab=0 rd.luks=0 rd.lvm=0 rd.md=0 rd.dm=0 rd.auto=0 rd.systemd.gpt_auto=0 systemd.gpt_auto=0 vt.color=0x02 console=tty0 console=ttyS0,115200n8
        initrd /initramfs.img
    fi
}
menuentry 'Gentoo rescue (verify boot files)' {
    echo 'Checking boot files against SHA256SUMS...'
    set verified=0
    insmod hashsum
    insmod gcry_sha256
    if search --no-floppy --fs-uuid --set=root @CARRIER_UUID@; then
        if test -s /SHA256SUMS; then
            if hashsum --hash sha256 --check /SHA256SUMS --keep-going --prefix "($root)"; then
                set verified=1
            fi
        fi
    fi
    if test "$verified" = 1; then
        linux /vmlinuz root=rescue:UUID=@CARRIER_UUID@ ro fsck.mode=skip rd.fstab=0 rd.luks=0 rd.lvm=0 rd.md=0 rd.dm=0 rd.auto=0 rd.systemd.gpt_auto=0 systemd.gpt_auto=0 vt.color=0x02 console=tty0 console=ttyS0,115200n8
        initrd /initramfs.img
    else
        echo 'Boot file verification failed. Boot canceled.'
        echo 'Press ESC to exit.'
        sleep --interruptible 300
    fi
}
